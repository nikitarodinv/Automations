{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider manifest (providers/<name>.yaml)",
  "type": "object",
  "required": ["name", "capabilities", "auth"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "docs": { "type": "string" },
    "terms_checked": { "type": "boolean" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "enum": ["source", "finder", "enrich"] } },
    "auth": {
      "type": "object",
      "required": ["type", "env"],
      "properties": {
        "type": { "enum": ["header", "bearer", "query"] },
        "name": { "type": "string" },
        "env": { "type": "string" }
      }
    },
    "free_plan": {
      "type": "object",
      "properties": {
        "monthly": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "resets": { "enum": ["calendar_month", "signup_day"] },
        "reset_day": { "type": "integer", "minimum": 1, "maximum": 28 },
        "balance": {
          "type": "object",
          "required": ["url", "field"],
          "properties": {
            "method": { "type": "string" },
            "url": { "type": "string" },
            "field": { "type": "string" },
            "fallback_field": { "type": "string" },
            "reset_field": { "type": "string" }
          }
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "properties": { "per_second": { "type": "number" }, "per_minute": { "type": "number" } }
    },
    "errors": { "type": "object", "additionalProperties": { "enum": ["ok", "not_found", "claimed", "auth", "quota", "transient", "data"] } },
    "error_codes": { "type": "object", "additionalProperties": { "enum": ["ok", "not_found", "claimed", "auth", "quota", "transient", "data"] } },
    "finder": {
      "type": "object",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "required": ["method", "url"],
          "properties": {
            "method": { "enum": ["GET", "POST"] },
            "url": { "type": "string" },
            "params": { "type": "object" },
            "json": { "type": "object" }
          }
        },
        "response": {
          "type": "object",
          "required": ["email"],
          "properties": {
            "email": { "type": "string" },
            "score": { "type": "string" },
            "status": { "type": "string" },
            "found_when": { "type": "string" },
            "person": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "score_scale": { "type": "number", "exclusiveMinimum": 0 },
        "status_map": { "type": "object", "additionalProperties": { "enum": ["valid", "accept_all", "unknown", "invalid"] } },
        "status_default": { "enum": ["valid", "accept_all", "unknown", "invalid"] },
        "status_scores": { "type": "object", "additionalProperties": { "type": "integer" } },
        "cost": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "source": { "type": "object" },
    "enrich": { "type": "object" }
  }
}
